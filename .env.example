# Параметры сервиса генерации
DEBUG=false
HOST=0.0.0.0
PORT=8000

# База данных
DATABASE_URL=postgresql+asyncpg://generation:generation@localhost:5432/generation

# Общий секрет для HMAC-подписи вебхуков (провайдеры и платежи)
WEBHOOK_SECRET=change-me

# Таймауты
PROVIDER_TIMEOUT=60
PROVIDER_CALL_TIMEOUT=10
ACTIVE_TASKS_LIMIT=3

# Интервалы фоновых циклов (сек)
WATCHDOG_INTERVAL=1.0
DISPATCH_INTERVAL=1.0

# Базовые URL фейковых провайдеров
ALPHA_BASE_URL=http://alpha:8001
BETA_BASE_URL=http://beta:8002

# URL, по которому провайдеры шлют вебхуки обратно в сервис
SERVICE_BASE_URL=http://app:8000

# Телеметрия (выключена по умолчанию — коллектора в compose нет)
OTEL_ENABLED=false
OTEL_ENDPOINT=
